{
  "expo": {
    "name": "VibeForge Desk",
    "slug": "vibeforge-desk",
    "scheme": "vibeforge-desk",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#080810"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vibeforge.desk",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "VibeForge Desk uses the camera to capture photos inside the app before you publish them.",
        "NSPhotoLibraryUsageDescription": "VibeForge Desk accesses your photo library to let you choose media that appears in the app.",
        "NSCalendarsUsageDescription": "VibeForge Desk uses your calendar to place app events onto your device schedule."
      }
    },
    "android": {
      "package": "com.vibeforgestudios.desk",
      "versionCode": 1,
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#080810"
      }
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {}
  }
}
